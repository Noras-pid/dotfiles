#!/usr/bin/env python3
# nightlight-auto: turn the night light on at sunset and off at sunrise
# (Voronovytsia, sun times from Open-Meteo, cached per day). Acts only when
# day turns to night or back, so a manual toggle stays until the next change.
import json, os, subprocess, urllib.request
from datetime import datetime, date

LAT, LON = 49.1118, 28.6889
CACHE = os.path.expanduser("~/.cache/nightlight-auto")
os.makedirs(CACHE, exist_ok=True)
sun_file, state_file = f"{CACHE}/sun.json", f"{CACHE}/last"

def sun_times():
    today = date.today().isoformat()
    try:
        c = json.load(open(sun_file))
        if c["date"] == today:
            return c["rise"], c["set"]
    except Exception:
        pass
    try:
        url = (f"https://api.open-meteo.com/v1/forecast?latitude={LAT}&longitude={LON}"
               "&daily=sunrise,sunset&timezone=auto&forecast_days=1")
        d = json.load(urllib.request.urlopen(url, timeout=10))["daily"]
        rise, sset = d["sunrise"][0][11:16], d["sunset"][0][11:16]
        json.dump({"date": today, "rise": rise, "set": sset}, open(sun_file, "w"))
        return rise, sset
    except Exception:
        return "07:00", "19:00"

rise, sset = sun_times()
now = datetime.now().strftime("%H:%M")
want = "off" if rise <= now < sset else "on"
last = open(state_file).read().strip() if os.path.exists(state_file) else ""
if want != last:
    subprocess.run([os.path.expanduser("~/.local/bin/orrery-nightlight"), want])
    open(state_file, "w").write(want)
