#!/usr/bin/env bash
set -euo pipefail
umask 077
pidfile="${XDG_RUNTIME_DIR:-/tmp}/orrery-record.pid"
logdir="${XDG_STATE_HOME:-$HOME/.local/state}/orrery"
mkdir -p "$logdir"
logfile="$logdir/recording.log"

# A detached supervisor owns the encoder and reports its actual result.
if [[ ${1:-} == --worker ]]; then
    output="$2"; shift 2
    gpu-screen-recorder "$@" -write-first-frame-ts yes >"$logfile" 2>&1 &
    pid=$!
    printf '%s\n' "$pid" >"$pidfile.tmp"
    mv -f -- "$pidfile.tmp" "$pidfile"
    started=0
    for ((i=0; i<100; i++)); do
        if [[ -s "$output.ts" ]] && kill -0 "$pid" 2>/dev/null; then
            started=1
            notify-send -a Orrery "Recording started" "Press the shortcut again to save" || true
            break
        fi
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    if (( ! started )) && kill -0 "$pid" 2>/dev/null; then
        printf '\nRecorder did not produce a first frame within 10 seconds.\n' >>"$logfile"
        kill -TERM "$pid" 2>/dev/null || true
    fi
    if wait "$pid"; then rc=0; else rc=$?; fi
    rm -f -- "$output.ts"
    if [[ $(cat "$pidfile" 2>/dev/null) == "$pid" ]]; then rm -f -- "$pidfile"; fi
    if (( started && rc == 0 )) && [[ -s "$output" ]]; then
        notify-send -a Orrery "Recording saved" "$output" || true
    else
        notify-send -a Orrery -u critical "Recording failed" "Details: $logfile" || true
    fi
    exit "$rc"
fi

mode="${2:-screen}"
case "$mode" in screen|sound|region) ;; *) echo 'usage: orrery-record toggle [screen|sound|region]' >&2; exit 1 ;; esac
# Prevent two rapid shortcut presses from starting two encoders.
exec 9>"$pidfile.lock"
flock 9
if [[ -f "$pidfile" ]]; then
    pid="$(cat "$pidfile")"
    is_recorder=0
    if [[ $pid =~ ^[0-9]+$ ]] && [[ -r "/proc/$pid/cmdline" ]]; then
        mapfile -d '' -t procargs <"/proc/$pid/cmdline" || true
        for arg in "${procargs[@]:0:2}"; do
            [[ ${arg##*/} == gpu-screen-recorder ]] && is_recorder=1
        done
    fi
    if (( is_recorder )) && kill -0 "$pid" 2>/dev/null; then
        kill -INT "$pid"
        # The supervisor announces completion after the file is flushed.
        exit 0
    fi
    rm -f "$pidfile"
fi
mkdir -p "$HOME/Videos/Recordings"
output="$HOME/Videos/Recordings/$(date +%Y-%m-%d_%H-%M-%S-%N).mp4"
args=(-w eDP-1 -f 60 -o "$output")
if [[ "$mode" == sound ]]; then args+=(-a default_output); fi
if [[ "$mode" == region ]]; then
    geometry="$(slurp)" || exit 0
    coords="${geometry% *}"
    size="${geometry#* }"
    args=(-w region -region "${size}+${coords/,/+}" -f 60 -o "$output")
fi
setsid -f "$(readlink -f -- "$0")" --worker "$output" "${args[@]}" 9>&- >/dev/null 2>&1
# Give the supervisor time to publish its PID, then wait for the first frame.
for ((i=0; i<110; i++)); do
    [[ -s "$output.ts" && -f "$pidfile" ]] && exit 0
    if (( i > 2 )) && [[ ! -f "$pidfile" ]]; then exit 1; fi
    sleep 0.1
done
exit 1
