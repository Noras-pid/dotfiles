#!/usr/bin/env bash
# orrery-default <terminal|browser|agent> [name] — show or set a default app.
# Stored in ~/.config/orrery/defaults/<kind>; binds.lua reads terminal
# and browser from there (SUPER+Return, SUPER+B); agent is orrery-agent's.
kind="${1:?usage: orrery-default terminal|browser|agent [name]}"; name="${2:-}"
dir="$HOME/.config/orrery/defaults"
case "$kind" in
    agent) exec "$HOME/.local/bin/orrery-agent" default ${name:+"$name"} ;;
    terminal|browser) ;;
    *) echo "unknown kind: $kind" >&2; exit 1 ;;
esac
if [[ -z "$name" ]]; then
    saved="$(cat "$dir/$kind" 2>/dev/null || true)"
    if [[ -n "$saved" ]] && command -v "$saved" >/dev/null 2>&1; then
        echo "$saved"
    else
        candidates="kitty alacritty foot"
        [[ $kind == browser ]] && candidates="firefox zen-browser chromium brave"
        for candidate in $candidates; do
            if command -v "$candidate" >/dev/null 2>&1; then echo "$candidate"; exit 0; fi
        done
        echo "No installed $kind found" >&2; exit 1
    fi
else
    command -v "$name" >/dev/null 2>&1 || { echo "$name is not installed" >&2; exit 1; }
    mkdir -p "$dir"; printf '%s\n' "$name" > "$dir/$kind"
    hyprctl reload >/dev/null 2>&1
    echo "default $kind: $name"
fi
