#!/usr/bin/env python3
"""Rewrites the Windows computer name inside the SL Proton prefix.
Wine seeds it from the Linux hostname, so a fresh prefix brings the old one back."""
import os, re, random, string, sys, pathlib

PFX = pathlib.Path.home()/".local/share/Steam/steamapps/compatdata/700330/pfx"
D   = pathlib.Path.home()/".local/share/sl-fakeid"
reg = PFX/"system.reg"
if not reg.exists():
    print("  computer name   prefix not built yet - rerun after first launch"); sys.exit(0)

D.mkdir(parents=True, exist_ok=True)
f = D/"computername"
if "--new" in sys.argv or not f.exists():
    f.write_text("DESKTOP-" + "".join(random.choices(string.ascii_uppercase+string.digits, k=7)) + "\n")
name = f.read_text().strip()

# Wine builds the Windows SID from /etc/machine-id, so keep user.reg consistent
# with the fake one the shim serves.
mid = D/"machine-id"
if mid.exists():
    h = mid.read_text().strip()
    sid = f"S-1-5-21-{int(h[:8],16)}-{int(h[8:16],16)}-1000-1000"
    ur = PFX/"user.reg"
    if ur.exists():
        u = ur.read_text(encoding="utf-8", errors="ignore")
        u, c = re.subn(r"S-1-5-21-\d+-\d+-\d+-\d+", sid, u)
        if c:
            ur.write_text(u, encoding="utf-8")
            print(f"  SID             {sid}  ({c} occurrence(s))")

t = reg.read_text(encoding="utf-8", errors="ignore")
t, n = re.subn(r'("(?:Active)?ComputerName"=")[^"]*(")', lambda m: m.group(1)+name+m.group(2), t)
if n:
    reg.write_text(t, encoding="utf-8")
    print(f"  computer name   {name}  ({n} key(s))")
else:
    print("  computer name   no key found")
