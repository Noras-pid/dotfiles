#!/bin/bash
set -e
if ! systemctl --user is-active --quiet openbullet2.service; then
  systemd-run --user --unit=openbullet2 --collect --property=WorkingDirectory=/home/noras/.local/opt/openbullet2 /home/noras/.local/opt/openbullet2/OpenBullet2.Web --urls http://127.0.0.1:5000
fi
for attempt in {1..30}; do
  if curl -fsS -o /dev/null http://127.0.0.1:5000/; then
    exec xdg-open http://127.0.0.1:5000/
  fi
  sleep 1
done
printf 'OpenBullet 2 did not start. Check: journalctl --user -u openbullet2\n' >&2
exit 1
