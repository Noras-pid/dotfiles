[Desktop Entry]
Type=Application
Name=Archive as Folder
Comment=Browse the archive in Thunar; copy files out with Ctrl+C / Ctrl+V
Icon=ark
Exec=/home/noras/.local/bin/archive-folder %f
Terminal=false
NoDisplay=true
MimeType=application/zip;application/x-zip-compressed;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-tar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lzma-compressed-tar;application/x-cpio;
